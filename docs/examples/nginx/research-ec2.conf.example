# DESIGN ARTIFACT ONLY. Not installed, included, or enabled by this repository.
# Native host Uvicorn: 127.0.0.1:8000; JWT authorization sidecar: 127.0.0.1:4180.
# The sidecar is a required future component, not an implemented permissive stub.
# Replace reserved hostname/certificate paths only after deployment authorization.
worker_processes auto;
pid /run/nginx.pid;
# Native Nginx error messages can include URLs/identifiers. Do not export them.
# A reviewed redacted diagnostic sink is a prerequisite for operational promotion.
error_log /dev/null crit;

events {
    worker_connections 1024;
}

http {
    server_tokens off;
    log_format research_status '$request_id $status $request_time $body_bytes_sent';
    access_log /var/log/nginx/research-access.log research_status;
    limit_req_zone $binary_remote_addr zone=research_requests:10m rate=2r/s;
    limit_conn_zone $binary_remote_addr zone=research_connections:10m;

    upstream research_api {
        server 127.0.0.1:8000;
        keepalive 8;
    }
    upstream research_authorization {
        server 127.0.0.1:4180;
    }

    server {
        listen 80 default_server;
        listen [::]:80 default_server;
        server_name _;
        return 444;
    }
    server {
        listen 80;
        listen [::]:80;
        server_name research.example.invalid;
        return 308 https://research.example.invalid$request_uri;
    }
    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        server_name _;
        ssl_reject_handshake on;
    }
    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        server_name research.example.invalid;
        ssl_certificate /etc/letsencrypt/live/research.example.invalid/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/research.example.invalid/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_tickets off;
        ssl_session_cache shared:research_tls:10m;

        client_max_body_size 2m;
        client_header_timeout 10s;
        client_body_timeout 10s;
        keepalive_timeout 15s;
        send_timeout 30s;
        limit_req_status 429;
        limit_conn_status 429;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        # Enable only once the approved hostname has working HTTPS and renewal.
        add_header Strict-Transport-Security "max-age=86400" always;

        # Health/readiness remain local operations, not public capability claims.
        location = /health {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            access_log off;
            proxy_pass http://research_api;
        }
        location = /ready {
            allow 127.0.0.1;
            allow ::1;
            deny all;
            access_log off;
            proxy_pass http://research_api;
        }
        location ~ ^/(docs|redoc|openapi\.json)(/|$) {
            return 404;
        }

        location = /_research_authorize {
            internal;
            proxy_pass http://research_authorization/verify;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie "";
            proxy_set_header X-Required-Scope "research:inference";
            proxy_set_header Host "research.example.invalid";
            proxy_connect_timeout 2s;
            proxy_read_timeout 5s;
        }

        # The first prospective public demo exposes one stateless research route.
        # All database/agent/controller routes remain private, not deleted in FastAPI.
        location = /api/v1/research/sepsis/trajectory/raw-hourly {
            limit_except POST { deny all; }
            limit_req zone=research_requests burst=4 nodelay;
            limit_conn research_connections 2;
            auth_request /_research_authorize;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_pass http://research_api;
            proxy_connect_timeout 2s;
            proxy_read_timeout 30s;
            proxy_send_timeout 30s;
            # Replace client-supplied proxy/identity headers; never append an
            # untrusted X-Forwarded-For chain at the first internet-facing proxy.
            proxy_set_header Host "research.example.invalid";
            proxy_set_header X-Forwarded-Host "research.example.invalid";
            proxy_set_header X-Forwarded-Proto "https";
            proxy_set_header X-Forwarded-Port "443";
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header X-Authenticated-User "";
            proxy_set_header Authorization "";
            proxy_set_header Cookie "";
        }
        location / {
            return 404;
        }
    }
}

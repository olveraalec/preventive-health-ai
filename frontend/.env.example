# Public browser configuration only. Never add credentials here.
# Empty uses same-origin /api; Vite development proxies to the local backend.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8003
# Absolute http(s) URL to the teammate's separate Streamlit application.
# Local demo: http://127.0.0.1:8501 (set explicitly in .env.local; not a public default).
VITE_STREAMLIT_URL=
# Optional public identifiers for the synthetic-input model demonstration.
# Copy from the approved installed manifest; do not guess model identifiers.
VITE_DEMO_MODEL_ARTIFACT_ID=
VITE_DEMO_MODEL_VERSION=
